# ============================================================
# AgentTutor — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-me-use-a-long-random-string

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql://agenttutor:password@localhost:5432/agenttutor_dev
# Test database (separate DB to avoid clobbering dev data)
TEST_DATABASE_URL=postgresql://agenttutor:password@localhost:5432/agenttutor_test

# --- LLM Provider ---
# Supported: openai | anthropic | google | mock
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Embedding Provider ---
# Supported: openai | sentence_transformers | mock
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- Retrieval ---
# Set to true to enable pgvector semantic search
ENABLE_VECTOR_SEARCH=false
# Fallback: simple keyword search when vector search is disabled
RETRIEVAL_TOP_K=5

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,txt,md,docx
UPLOAD_DIR=./uploads

# --- Security ---
CORS_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=200 per day, 50 per hour
RATE_LIMIT_MESSAGES=30 per minute

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Code Execution (optional isolated runner) ---
ENABLE_CODE_EXECUTION=false
CODE_RUNNER_TIMEOUT_SECONDS=10

# --- Frontend (Vite) ---
# These are exposed to the browser — DO NOT put secrets here
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=AgentTutor

